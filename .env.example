# ---------------------------------------------------------------------------
# Referral inbox (cmd/inbox) - REQUIRED
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# ID of the Google Sheet used as the referral store.
# Taken from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Google service account credentials JSON, base64 encoded into a single line:
#   base64 -i service-account.json | tr -d '\n'
# Remember to share the spreadsheet with the service account's client_email
# (Editor access), otherwise every call returns 403.
GOOGLE_SA_JSON_B64=

# ---------------------------------------------------------------------------
# Referral inbox - OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------

# Max referrals a single Telegram chat may submit per rolling window.
REFERRAL_RATE_LIMIT=1

# Length of the rolling rate limit window, in days.
REFERRAL_RATE_LIMIT_WINDOW_DAYS=7

# Number of Telegram updates fetched per getUpdates call (1-100).
TELEGRAM_POLL_LIMIT=100

# Your own numeric Telegram chat id. When set, each run messages you a digest of how many
# referrals are pending. A bot cannot message itself, so this must be YOUR chat with the bot,
# and you must have pressed Start in it first. Leave empty to disable the digest.
# Find it by sending the bot a message, then reading chat.id from the getUpdates response.
OWNER_CHAT_ID=

# ---------------------------------------------------------------------------
# RAG assistant CLI (cmd/cli) - OPTIONAL, not used by the referral inbox
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
QDRANT_API_KEY=
SYS_PROMPT_PATH=./sysprompts/basic-v1.md
